# Supabase público (pode ser exposto no navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=project-documents

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase server-side (nunca enviar ao navegador)
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=

# Apenas desenvolvimento local explícito; nunca habilitar em produção
TURNSTILE_DEV_BYPASS=false
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
